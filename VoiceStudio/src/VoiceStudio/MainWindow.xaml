<Window x:Class="VoiceStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Studio" Width="860" Height="720" MinWidth="720" MinHeight="560"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen">

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Voice Studio" Foreground="{StaticResource TextBrush}" FontSize="24"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOutputFlowing}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Content="{Binding ToggleLabel}" Command="{Binding ToggleEngineCommand}"
                    Style="{StaticResource PrimaryButton}" MinWidth="150" VerticalAlignment="Center" />
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="1">
            <Border Background="{StaticResource DangerSurfaceBrush}" CornerRadius="10" Padding="16,12"
                    Margin="0,0,0,12" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="13"
                           TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource WarningSurfaceBrush}" CornerRadius="10" Padding="16,12"
                    Margin="0,0,0,12" Visibility="{Binding CableMissing, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="13" TextWrapping="Wrap"
                           Text="Aucun micro virtuel détecté. Installe VB-CABLE (vb-audio.com/Cable), redémarre le PC, puis clique sur « Actualiser »." />
            </Border>
        </StackPanel>

        <!-- Corps -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- Périphériques -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PÉRIPHÉRIQUES" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ton micro" Style="{StaticResource FieldLabel}" />
                                <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Microphones}"
                                          SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Name" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sortie vers Discord — choisis « CABLE Input »"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Outputs}"
                                          SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name" />
                            </StackPanel>

                            <Button Grid.Column="4" Content="Actualiser" Command="{Binding RefreshDevicesCommand}"
                                    Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Height="36" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Mixage -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="MIXAGE" Style="{StaticResource SectionTitle}" />

                        <!-- Microphone -->
                        <Grid DataContext="{Binding Microphone}" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <Slider Grid.Row="0" Grid.Column="1" Value="{Binding Volume}"
                                    Style="{StaticResource VolumeSlider}" Margin="4,0,10,0" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding VolumeText}"
                                       Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ToggleButton Grid.Row="0" Grid.Column="3" IsChecked="{Binding IsMuted}"
                                          Style="{StaticResource MuteToggle}" HorizontalAlignment="Right"
                                          ToolTip="Couper ou réactiver cette source" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Value="{Binding Level, Mode=OneWay}"
                                         Style="{StaticResource LevelMeter}" Margin="0,10,0,0" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,16" />

                        <!-- Sons du PC -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                        DataContext="{Binding SystemAudio}">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <Slider Grid.Row="0" Grid.Column="1" Value="{Binding SystemAudio.Volume}"
                                    Style="{StaticResource VolumeSlider}" Margin="4,0,10,0" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SystemAudio.VolumeText}"
                                       Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ToggleButton Grid.Row="0" Grid.Column="3" IsChecked="{Binding SystemAudio.IsMuted}"
                                          Style="{StaticResource MuteToggle}" HorizontalAlignment="Right"
                                          ToolTip="Couper ou réactiver cette source" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="4"
                                         Value="{Binding SystemAudio.Level, Mode=OneWay}"
                                         Style="{StaticResource LevelMeter}" Margin="0,10,0,0" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="{Binding SystemAudioStatus}"
                                       Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,16" />

                        <!-- Sortie -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Volume général" Style="{StaticResource TitleText}" />
                                <TextBlock Text="Ce qui part vers Discord" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <Slider Grid.Row="0" Grid.Column="1" Value="{Binding MasterVolume}"
                                    Style="{StaticResource VolumeSlider}" Margin="4,0,10,0" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MasterVolumeText}"
                                       Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Limiteur actif"
                                       Foreground="{StaticResource WarningBrush}" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Visibility="{Binding IsLimiting, Converter={StaticResource BoolToVisibility}}" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Value="{Binding MasterLevel, Mode=OneWay}"
                                         Style="{StaticResource LevelMeter}" Margin="0,10,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Réglages avancés -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource SectionToggle}">
                            <TextBlock Text="Réglages avancés" Style="{StaticResource TitleText}" />
                        </ToggleButton>
                        <StackPanel Margin="20,14,0,0"
                                    Visibility="{Binding IsChecked, ElementName=AdvancedToggle,
                                                 Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Latence de sortie :" />
                                <Run Text="{Binding OutputLatencyMs, Mode=OneWay}" />
                                <Run Text="ms" />
                            </TextBlock>
                            <Slider Minimum="10" Maximum="200" Value="{Binding OutputLatencyMs, Delay=400}"
                                    Style="{StaticResource VolumeSlider}" SmallChange="5" LargeChange="10"
                                    MaxWidth="360" HorizontalAlignment="Left" Width="360" />
                            <TextBlock Text="Plus bas = moins de délai, mais plus de risque de craquements."
                                       Style="{StaticResource MutedText}" Margin="0,6,0,0" />

                            <TextBlock Text="Applications exclues" Style="{StaticResource FieldLabel}"
                                       Margin="2,18,0,6" />
                            <TextBox Text="{Binding ExcludedAppsText, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DarkTextBox}" MaxWidth="420" HorizontalAlignment="Left"
                                     Width="420" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" MaxWidth="480"
                                       HorizontalAlignment="Left"
                                       Text="Leur son n'est jamais envoyé dans le micro. Garde Discord dans la liste, sinon tes amis s'entendraient en écho. Noms de processus séparés par des virgules." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Aide Discord -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ToggleButton x:Name="HelpToggle" Style="{StaticResource SectionToggle}">
                            <TextBlock Text="Comment régler Discord" Style="{StaticResource TitleText}" />
                        </ToggleButton>
                        <StackPanel Margin="20,14,0,0"
                                    Visibility="{Binding IsChecked, ElementName=HelpToggle,
                                                 Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8"
                                       Text="1.  Paramètres utilisateur → Voix et vidéo." />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8"
                                       Text="2.  Périphérique d'entrée : CABLE Output (VB-Audio Virtual Cable)." />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8"
                                       Text="3.  Désactive la suppression de bruit, l'annulation d'écho et le contrôle automatique du gain : ils coupent la musique." />
                            <TextBlock Style="{StaticResource BodyText}"
                                       Text="4.  Sensibilité de la voix : règle-la à la main, assez bas pour que la musique passe." />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
