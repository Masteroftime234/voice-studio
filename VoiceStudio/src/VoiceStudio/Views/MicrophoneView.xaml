<UserControl x:Class="VoiceStudio.Views.MicrophoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel DataContext="{Binding Microphone}">

            <!-- Avertissement micro virtuel -->
            <Border Background="{StaticResource WarningSurfaceBrush}" CornerRadius="10" Padding="16,12"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasMicrophoneWarning, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding MicrophoneWarning}"
                               Foreground="{StaticResource WarningBrush}" FontSize="13" TextWrapping="Wrap"
                               Margin="0,0,12,0" />
                    <Button Grid.Column="1" Content="Ne plus afficher" Command="{Binding DismissWarningCommand}"
                            Style="{StaticResource IconButton}" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- Gain -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Volume du micro" Style="{StaticResource TitleText}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="À monter si tes amis t'entendent trop bas sur Discord. Monte par petits pas : au-delà de +12 dB, le souffle du micro monte aussi." />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Gain" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="-12" Maximum="24"
                                SmallChange="1" LargeChange="3" Value="{Binding MicrophoneGainDb}" />
                        <TextBlock Grid.Column="2" Text="{Binding MicrophoneGainText}"
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,14,0,0"
                          Visibility="{Binding HasWindowsInputLevel,
                                       Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Niveau Windows" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100"
                                Value="{Binding WindowsInputLevel}" />
                        <TextBlock Grid.Column="2" Text="{Binding WindowsInputLevelText}"
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Style="{StaticResource MutedText}" Margin="120,6,0,0"
                               Text="Le volume d'entrée réglé dans Windows. S'il est bas, monte-le d'abord : c'est un vrai niveau, pas un rattrapage." />
                </StackPanel>
            </Border>

            <!-- Bascule micro / source -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Envoyer une source à la place du micro"
                                       Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="Une touche coupe ton micro et envoie à sa place la source choisie : musique, soundboard, son d'un jeu. Tant que la bascule est active, la source est silencieuse le reste du temps." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding SwitchEnabled}" VerticalAlignment="Top" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Source" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}"
                                  ItemsSource="{Binding SwitchTargets}"
                                  SelectedItem="{Binding SelectedSwitchTarget}" DisplayMemberPath="Name" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="120,14,0,0">
                        <Button Content="Choisir la touche" Command="{Binding CaptureSwitchKeyCommand}"
                                Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,10,0" />
                        <Button Content="Effacer" Command="{Binding ClearSwitchKeyCommand}"
                                Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding SwitchKeyText}" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Appuie maintenant sur la touche de ton choix…" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" Margin="120,10,0,0"
                               Visibility="{Binding IsCapturingSwitchKey,
                                            Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal" Margin="120,16,0,0">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SwitchHold}"
                                      Margin="0,0,12,0" />
                        <TextBlock Text="{Binding SwitchModeText}" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" MaxWidth="420" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Test du micro -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Tester mon micro" Style="{StaticResource TitleText}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" MaxWidth="620"
                               HorizontalAlignment="Left"
                               Text="Cinq secondes d'enregistrement, puis Voice Studio te réécoute telle que Discord t'entend — effets et nettoyage compris — et te dit s'il faut changer le gain. Personne d'autre n'entend cette réécoute." />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Lancer le test" Command="{Binding StartTestCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="18,9" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding TestState}" Foreground="{StaticResource AccentBrush}"
                                   FontSize="13" VerticalAlignment="Center"
                                   Visibility="{Binding IsTestRunning,
                                                Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Border Background="{StaticResource ControlBrush}" CornerRadius="10" Padding="14,12"
                            Margin="0,16,0,0" HorizontalAlignment="Left" MaxWidth="620"
                            Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding TestSuggestionText}" Style="{StaticResource BodyText}" />
                            <TextBlock Text="{Binding TestLevelsText}" Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                            <Button Content="Appliquer le gain conseillé"
                                    Command="{Binding ApplySuggestedGainCommand}"
                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Suppression du bruit -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Suppression du bruit" Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="Enlève le souffle du micro, le ventilateur et le bourdonnement de fond, sans couper ta voix. À utiliser à la place de Krisp, que Discord doit laisser désactivé." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding NoiseSuppressionEnabled}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Intensité" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100"
                                Value="{Binding NoiseSuppressionStrength}" />
                    </Grid>
                    <TextBlock Text="{Binding NoiseSuppressionStrengthText}" Style="{StaticResource MutedText}"
                               Margin="120,6,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,0"
                               Text="Désactivée, ta voix part vers Discord exactement telle qu'elle est captée." />
                    <TextBlock Text="{Binding DropoutText}" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDropouts}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Niveau automatique -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Niveau automatique" Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="Maintient ta voix au même niveau, que tu parles fort ou doucement, que tu sois près ou loin du micro. Le gain ne bouge que lentement et jamais pendant les silences." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding AutoLevelEnabled}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Niveau visé" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="-40" Maximum="-6"
                                Value="{Binding AutoLevelTargetDb}" />
                        <TextBlock Grid.Column="2" Text="{Binding AutoLevelTargetText}"
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Noise gate -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Couper le micro quand tu ne parles pas"
                                       Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="Ferme complètement le micro entre deux phrases. Si le début de tes mots saute, baisse le seuil." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding NoiseGateEnabled}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Seuil" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="-70" Maximum="-10"
                                Value="{Binding NoiseGateThresholdDb}" />
                        <TextBlock Grid.Column="2" Text="{Binding NoiseGateThresholdText}"
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Push-to-talk -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Push-to-talk" Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="Ton micro ne passe que pendant que tu maintiens la touche. Elle fonctionne même quand Voice Studio n'est pas au premier plan." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding PushToTalkEnabled}" VerticalAlignment="Top" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Choisir la touche" Command="{Binding CaptureKeyCommand}"
                                Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,10,0" />
                        <Button Content="Effacer" Command="{Binding ClearKeyCommand}"
                                Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding PushToTalkKeyText}" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Appuie maintenant sur la touche de ton choix…" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0"
                               Visibility="{Binding IsCapturingKey, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Auto-ducking -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Baisser les autres sons quand je parle"
                                       Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="La musique et les jeux reculent dès que tu prends la parole, puis remontent tout seuls." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding DuckingEnabled}" VerticalAlignment="Top" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Volume pendant que tu parles"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100"
                                Value="{Binding DuckingMinimumVolume}" />
                        <TextBlock Grid.Column="2" Text="{Binding DuckingMinimumVolumeText}"
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sensibilité de ta voix"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="-60" Maximum="-10"
                                Value="{Binding DuckingThresholdDb}" />
                        <TextBlock Grid.Column="2" Text="{Binding DuckingThresholdText}"
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Temps avant de remonter"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="50" Maximum="3000"
                                Value="{Binding DuckingReleaseMs}" />
                        <TextBlock Grid.Column="2" Text="{Binding DuckingReleaseText}"
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Baisse pendant un extrait -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Baisser les sons pendant un extrait"
                                       Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="Quand tu lances un son du soundboard, la musique et les jeux reculent le temps qu'il passe." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding SoundboardDuckingEnabled}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Volume pendant l'extrait"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100"
                                Value="{Binding SoundboardDuckingMinimum}" />
                        <TextBlock Grid.Column="2" Text="{Binding SoundboardDuckingMinimumText}"
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Retour audio -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="M'entendre dans mon casque" Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="Pratique pour régler les effets. Avec des enceintes, le micro risque de se réentendre : garde un casque." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding MonitorEnabled}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Volume du retour" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="150"
                                Value="{Binding MonitorVolume}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
