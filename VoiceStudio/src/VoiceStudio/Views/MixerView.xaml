<UserControl x:Class="VoiceStudio.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- Une tranche : nom, curseur vertical, indicateur, bouton couper -->
        <DataTemplate x:Key="ChannelStrip">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Width="108" Margin="0,0,10,0" Padding="8,14">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13"
                               FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Subtitle}" />
                    <TextBlock Text="{Binding VolumeText}" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,2,0,12" />
                    <Grid HorizontalAlignment="Center" Height="190">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Style="{StaticResource VerticalVolumeSlider}"
                                Value="{Binding Volume}" Height="190" />
                        <Border Grid.Column="2" Width="6" CornerRadius="3" Background="#1C1C26">
                            <Rectangle Width="6" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3"
                                       Fill="{StaticResource MeterBrush}"
                                       Height="{Binding Level, Converter={StaticResource Scale},
                                                ConverterParameter=190}" />
                        </Border>
                    </Grid>
                    <ToggleButton Style="{StaticResource SmallMuteToggle}" IsChecked="{Binding IsMuted}"
                                  HorizontalAlignment="Center" Margin="0,14,0,0"
                                  ToolTip="Couper ou réactiver cette source" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Périphériques -->
        <Border Grid.Row="0" Style="{StaticResource Card}" DataContext="{Binding Mixer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ton micro" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Microphones}"
                              SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Name" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Sortie vers Discord — choisis « CABLE Input »"
                               Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Outputs}"
                              SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name" />
                </StackPanel>

                <Button Grid.Column="4" Content="Actualiser" Command="{Binding RefreshDevicesCommand}"
                        Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Height="36" />
            </Grid>
        </Border>

        <!-- Tranches -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="TABLE DE MIXAGE" Style="{StaticResource SectionTitle}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Padding="0,0,0,6">
                    <StackPanel Orientation="Horizontal" DataContext="{Binding Mixer}">

                        <!-- Volume général -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1" CornerRadius="12" Width="108" Margin="0,0,16,0" Padding="8,14">
                            <StackPanel>
                                <TextBlock Text="Général" Foreground="{StaticResource TextBrush}" FontSize="13"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding MasterVolumeText}" Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Center" Margin="0,2,0,12" />
                                <Grid HorizontalAlignment="Center" Height="190">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource VerticalVolumeSlider}"
                                            Value="{Binding MasterVolume}" Height="190" />
                                    <Border Grid.Column="2" Width="6" CornerRadius="3" Background="#1C1C26">
                                        <Rectangle Width="6" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3"
                                                   Fill="{StaticResource MeterBrush}"
                                                   Height="{Binding MasterLevel, Converter={StaticResource Scale},
                                                            ConverterParameter=190}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="Limiteur" Foreground="{StaticResource WarningBrush}" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,16,0,0"
                                           Visibility="{Binding IsLimiting,
                                                        Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <ContentPresenter Content="{Binding Microphone}"
                                          ContentTemplate="{StaticResource ChannelStrip}" />
                        <ContentPresenter Content="{Binding Soundboard}"
                                          ContentTemplate="{StaticResource ChannelStrip}" />

                        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource ChannelStrip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Width="190" Margin="0,0,10,0" CornerRadius="12" BorderThickness="1"
                                BorderBrush="{StaticResource CardBorderBrush}" Background="Transparent"
                                Visibility="{Binding HasApps, Converter={StaticResource NotBoolToVisibility}}">
                            <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" Margin="16"
                                       VerticalAlignment="Center"
                                       Text="Les applications qui jouent du son apparaissent ici, chacune avec son volume." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Text="{Binding Mixer.SystemAudioStatus}" Style="{StaticResource MutedText}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
