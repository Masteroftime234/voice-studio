<Window x:Class="VoiceStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:VoiceStudio.Views"
        Title="Voice Studio" Width="1020" Height="760" MinWidth="880" MinHeight="620"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre -->
        <Grid Grid.Row="0" Background="#0B0B10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Voice Studio" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" Style="{StaticResource TitleBarButton}" Click="OnMinimize"
                        ToolTip="Réduire" />
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource TitleBarButton}"
                        Click="OnMaximizeRestore" ToolTip="Agrandir" />
                <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="Fermer" />
            </StackPanel>
        </Grid>

        <!-- En-tête -->
        <Grid Grid.Row="1" Margin="26,14,26,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Voice Studio" Foreground="{StaticResource TextBrush}" FontSize="23"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOutputFlowing}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Content="{Binding ToggleLabel}" Command="{Binding ToggleEngineCommand}"
                    Style="{StaticResource PrimaryButton}" MinWidth="150" VerticalAlignment="Center" />
        </Grid>

        <!-- Onglets -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,18,26,14">
            <RadioButton Style="{StaticResource NavTab}" Content="Mixer" Command="{Binding GoToCommand}"
                         CommandParameter="mixer"
                         IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource SectionToBoolean},
                                     ConverterParameter=mixer}" />
            <RadioButton Style="{StaticResource NavTab}" Content="Voix" Command="{Binding GoToCommand}"
                         CommandParameter="voix"
                         IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource SectionToBoolean},
                                     ConverterParameter=voix}" />
            <RadioButton Style="{StaticResource NavTab}" Content="Micro" Command="{Binding GoToCommand}"
                         CommandParameter="micro"
                         IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource SectionToBoolean},
                                     ConverterParameter=micro}" />
            <RadioButton Style="{StaticResource NavTab}" Content="Soundboard" Command="{Binding GoToCommand}"
                         CommandParameter="soundboard"
                         IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource SectionToBoolean},
                                     ConverterParameter=soundboard}" />
            <RadioButton Style="{StaticResource NavTab}" Content="Réglages" Command="{Binding GoToCommand}"
                         CommandParameter="reglages"
                         IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource SectionToBoolean},
                                     ConverterParameter=reglages}" />
        </StackPanel>

        <!-- Messages -->
        <StackPanel Grid.Row="3" Margin="26,0,26,0">
            <Border Background="{StaticResource DangerSurfaceBrush}" CornerRadius="10" Padding="16,12"
                    Margin="0,0,0,12" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="13"
                           TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource WarningSurfaceBrush}" CornerRadius="10" Padding="16,12"
                    Margin="0,0,0,12"
                    Visibility="{Binding Mixer.CableMissing, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="13" TextWrapping="Wrap"
                           Text="Aucun micro virtuel détecté. Installe VB-CABLE (vb-audio.com/Cable), redémarre le PC, puis clique sur « Actualiser »." />
            </Border>
        </StackPanel>

        <!-- Pages -->
        <Grid Grid.Row="4" Margin="26,0,26,22">
            <views:MixerView Visibility="{Binding Section, Converter={StaticResource SectionToVisibility},
                                          ConverterParameter=mixer}" />
            <views:VoiceFxView Visibility="{Binding Section, Converter={StaticResource SectionToVisibility},
                                            ConverterParameter=voix}" />
            <views:MicrophoneView Visibility="{Binding Section, Converter={StaticResource SectionToVisibility},
                                               ConverterParameter=micro}" />
            <views:SoundboardView Visibility="{Binding Section, Converter={StaticResource SectionToVisibility},
                                               ConverterParameter=soundboard}" />
            <views:SettingsView Visibility="{Binding Section, Converter={StaticResource SectionToVisibility},
                                             ConverterParameter=reglages}" />
        </Grid>
    </Grid>
</Window>
