<UserControl x:Class="VoiceStudio.Views.VoiceFxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid DataContext="{Binding VoiceFx}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Presets -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Effets vocaux" Style="{StaticResource TitleText}" />
                        <TextBlock Text="Appliqués à ta voix avant qu'elle parte vers Discord."
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Activés" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding EffectsEnabled}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Preset" Style="{StaticResource FieldLabel}" />
                        <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Au hasard" Command="{Binding RandomCommand}"
                                Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,0"
                                ToolTip="Choisit un preset au hasard" />
                        <Button Content="Tout remettre à zéro" Command="{Binding ResetCommand}"
                                Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,0" />
                        <Button Content="Supprimer le preset" Command="{Binding DeletePresetCommand}"
                                Style="{StaticResource SecondaryButton}" Height="36" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Enregistrer les réglages actuels sous un nom"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource DarkTextBox}" Height="36"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Enregistrer" Command="{Binding SavePresetCommand}"
                            Style="{StaticResource PrimaryButton}" Height="36" VerticalAlignment="Bottom"
                            Padding="18,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Liste des effets -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Effects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                                  IsChecked="{Binding IsEnabled}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,12,0,0"
                                              Visibility="{Binding HasParameters,
                                                           Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           Style="{StaticResource MutedText}"
                                                           VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}"
                                                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                        Value="{Binding Value}" Margin="4,0,10,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                                           Style="{StaticResource BodyText}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
