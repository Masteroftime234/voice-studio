<Window x:Class="VoiceStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Studio" Width="940" Height="700" MinWidth="780" MinHeight="560"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Voice Studio" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Version 1 — moteur audio : ta voix + les sons du PC dans un micro virtuel"
                           Style="{StaticResource MutedText}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding ToggleLabel}" Command="{Binding ToggleEngineCommand}"
                    Style="{StaticResource PrimaryButton}" MinWidth="130" VerticalAlignment="Center" />
        </Grid>

        <!-- Erreur -->
        <Border Grid.Row="1" Background="{StaticResource DangerSurfaceBrush}" CornerRadius="8" Padding="14,10"
                Margin="0,0,0,12" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="13"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Câble virtuel absent -->
        <Border Grid.Row="2" Background="{StaticResource WarningSurfaceBrush}" CornerRadius="8" Padding="14,10"
                Margin="0,0,0,12" Visibility="{Binding CableMissing, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="13" TextWrapping="Wrap"
                       Text="Aucun micro virtuel détecté. Installe VB-CABLE (vb-audio.com/Cable), redémarre le PC, puis clique sur « Actualiser »." />
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Colonne gauche : table de mixage -->
                <StackPanel Grid.Column="0">

                    <!-- Microphone -->
                    <Border Style="{StaticResource Card}" DataContext="{Binding Microphone}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" IsChecked="{Binding IsMuted}"
                                              Style="{StaticResource MuteToggle}" VerticalAlignment="Top"
                                              ToolTip="Couper / réactiver cette source dans le mix" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Value="{Binding Volume}" Style="{StaticResource VolumeSlider}" />
                                <TextBlock Grid.Column="1" Text="{Binding VolumeText}" Style="{StaticResource BodyText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ProgressBar Value="{Binding Level, Mode=OneWay}" Style="{StaticResource LevelMeter}"
                                         Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Sons du PC -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid DataContext="{Binding SystemAudio}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" IsChecked="{Binding IsMuted}"
                                              Style="{StaticResource MuteToggle}" VerticalAlignment="Top"
                                              ToolTip="Couper / réactiver cette source dans le mix" />
                            </Grid>
                            <Grid Margin="0,14,0,0" DataContext="{Binding SystemAudio}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Value="{Binding Volume}" Style="{StaticResource VolumeSlider}" />
                                <TextBlock Grid.Column="1" Text="{Binding VolumeText}" Style="{StaticResource BodyText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ProgressBar DataContext="{Binding SystemAudio}" Value="{Binding Level, Mode=OneWay}"
                                         Style="{StaticResource LevelMeter}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding SystemAudioStatus}" Style="{StaticResource MutedText}"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Sortie -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sortie vers Discord" Style="{StaticResource TitleText}" />
                                    <TextBlock Text="Volume général, avec protection contre la saturation"
                                               Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Limiteur actif" Foreground="{StaticResource WarningBrush}"
                                           FontSize="12" VerticalAlignment="Top"
                                           Visibility="{Binding IsLimiting, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Value="{Binding MasterVolume}" Style="{StaticResource VolumeSlider}" />
                                <TextBlock Grid.Column="1" Text="{Binding MasterVolumeText}" Style="{StaticResource BodyText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ProgressBar Value="{Binding MasterLevel, Mode=OneWay}" Style="{StaticResource LevelMeter}"
                                         Margin="0,12,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutputFlowing}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding OutputStatus}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Colonne droite : périphériques et aide -->
                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Périphériques" Style="{StaticResource TitleText}" />

                            <TextBlock Text="Microphone" Style="{StaticResource MutedText}" Margin="0,14,0,5" />
                            <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                                      DisplayMemberPath="Name" />

                            <TextBlock Text="Sortie virtuelle (choisir « CABLE Input »)" Style="{StaticResource MutedText}"
                                       Margin="0,14,0,5" />
                            <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}"
                                      DisplayMemberPath="Name" />

                            <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,5">
                                <Run Text="Latence de sortie :" />
                                <Run Text="{Binding OutputLatencyMs, Mode=OneWay}" />
                                <Run Text="ms" />
                            </TextBlock>
                            <Slider Minimum="10" Maximum="200" Value="{Binding OutputLatencyMs, Delay=400}"
                                    Style="{StaticResource VolumeSlider}" SmallChange="5" LargeChange="10" />
                            <TextBlock Text="Plus bas = moins de délai, mais plus de risque de craquements."
                                       Style="{StaticResource MutedText}" Margin="0,6,0,0" />

                            <Button Content="Actualiser" Command="{Binding RefreshDevicesCommand}"
                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                    Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Applications exclues" Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,8"
                                       Text="Leur son n'est jamais envoyé dans le micro. Discord doit y rester, sinon tes amis s'entendraient en écho." />
                            <TextBox Text="{Binding ExcludedAppsText, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource DarkTextBox}" />
                            <TextBlock Text="Noms de processus séparés par des virgules (ex. Discord, vlc)."
                                       Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Réglage de Discord" Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                       Text="1. Paramètres utilisateur → Voix et vidéo." />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                                       Text="2. Périphérique d'entrée : « CABLE Output (VB-Audio Virtual Cable) »." />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                                       Text="3. Désactive la suppression de bruit, l'annulation d'écho et le contrôle automatique du gain : ils coupent la musique." />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                                       Text="4. Sensibilité de la voix : règle-la à la main, assez bas pour que la musique passe." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
