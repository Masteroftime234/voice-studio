<UserControl x:Class="VoiceStudio.Views.SoundboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid DataContext="{Binding Soundboard}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Soundboard" Style="{StaticResource TitleText}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                   Text="Tes extraits audio partent dans le micro virtuel, donc tes amis les entendent. Formats WAV, MP3 et la plupart de ceux que Windows sait lire." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Ajouter des sons" Command="{Binding AddCommand}"
                                Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0"
                                Margin="0,0,8,0" />
                        <Button Content="Tout arrêter" Command="{Binding StopAllCommand}"
                                Style="{StaticResource SecondaryButton}" Height="36" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Sons en même temps au maximum"
                               Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="1" Maximum="16"
                            Value="{Binding MaxSimultaneous}" />
                    <TextBlock Grid.Column="2" Text="{Binding MaxSimultaneous}" Style="{StaticResource BodyText}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource WarningSurfaceBrush}" CornerRadius="10" Padding="14,10"
                Margin="0,0,0,12" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarningBrush}" FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}"
                Visibility="{Binding HasSounds, Converter={StaticResource NotBoolToVisibility}}"
                VerticalAlignment="Top">
            <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,24"
                       Text="Aucun son pour l'instant. Clique sur « Ajouter des sons » pour choisir des fichiers." />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"
                      Visibility="{Binding HasSounds, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Sounds}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TitleText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource MutedText}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,12,0" />
                                </StackPanel>

                                <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource VolumeSlider}"
                                        Value="{Binding Volume}" Margin="4,0,10,0" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding VolumeText}"
                                           Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />

                                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="Jouer" Style="{StaticResource IconButton}" Padding="14,7"
                                            Command="{Binding DataContext.PlayCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Arrêter" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                            Command="{Binding DataContext.StopCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Retirer" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                            Command="{Binding DataContext.RemoveCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>

                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,12,0,0">
                                    <TextBlock Text="Découpe" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Style="{StaticResource DarkTextBox}" Width="60" Margin="0,0,6,0"
                                             ToolTip="Début, en secondes"
                                             Text="{Binding StartSeconds, StringFormat={}{0:0.0}}" />
                                    <TextBlock Text="→" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Style="{StaticResource DarkTextBox}" Width="60" Margin="0,0,10,0"
                                             ToolTip="Fin, en secondes (0 = jusqu'au bout)"
                                             Text="{Binding EndSeconds, StringFormat={}{0:0.0}}" />
                                    <TextBlock Text="Fondu" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Style="{StaticResource DarkTextBox}" Width="60" Margin="0,0,10,0"
                                             ToolTip="Durée des fondus, en millisecondes"
                                             Text="{Binding FadeMs, StringFormat={}{0:0}}" />
                                    <ToggleButton Content="Boucle" Style="{StaticResource TinyToggle}" Width="62"
                                                  IsChecked="{Binding Loop}" Margin="0,0,10,0"
                                                  ToolTip="Rejouer jusqu'à l'arrêt" />
                                    <TextBlock Text="{Binding TrimText}" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" />
                                </WrapPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal"
                                            Margin="0,12,0,0">
                                    <Button Content="Raccourci" Style="{StaticResource IconButton}"
                                            Command="{Binding DataContext.CaptureKeyCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Effacer" Style="{StaticResource IconButton}" Margin="6,0,12,0"
                                            Command="{Binding DataContext.ClearKeyCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding HotkeyText}" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="  •  appuie sur une touche…" FontSize="12"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding IsCapturingKey,
                                                            Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="  •  en cours de lecture" FontSize="12"
                                               Foreground="{StaticResource OkBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding IsPlaying,
                                                            Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="  •  fichier introuvable" FontSize="12"
                                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding IsMissing,
                                                            Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
