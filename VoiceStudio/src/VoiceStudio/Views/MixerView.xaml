<UserControl x:Class="VoiceStudio.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- Une tranche fixe : micro, soundboard -->
        <DataTemplate x:Key="ChannelStrip">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Width="104" Margin="0,0,10,0" Padding="8,14">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13"
                               FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
                    <TextBlock Text="{Binding VolumeText}" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,2,0,12" />
                    <Grid HorizontalAlignment="Center" Height="170">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Style="{StaticResource VerticalVolumeSlider}"
                                Value="{Binding Volume}" Height="170" />
                        <Border Grid.Column="2" Width="6" CornerRadius="3" Background="#1C1C26">
                            <Rectangle Width="6" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3"
                                       Fill="{StaticResource MeterBrush}"
                                       Height="{Binding Level, Converter={StaticResource Scale},
                                                ConverterParameter=170}" />
                        </Border>
                    </Grid>
                    <ToggleButton Style="{StaticResource SmallMuteToggle}" IsChecked="{Binding IsMuted}"
                                  HorizontalAlignment="Center" Margin="0,14,0,0"
                                  ToolTip="Couper ou réactiver cette source" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                                Visibility="{Binding HasRouting, Converter={StaticResource BoolToVisibility}}">
                        <ToggleButton Content="S" Style="{StaticResource TinyToggle}" Margin="0,0,6,0"
                                      IsChecked="{Binding IsSolo}"
                                      ToolTip="Solo : n'entendre que cette source" />
                        <ToggleButton Content="M" Style="{StaticResource TinyToggle}" IsChecked="{Binding IsMono}"
                                      ToolTip="Mono : ramener le son au centre" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Une étiquette d'application, déplaçable d'un bus à l'autre -->
        <DataTemplate x:Key="AppChip">
            <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                    Cursor="SizeAll" MouseMove="OnAppChipMouseMove"
                    ToolTip="Fais glisser cette application vers un autre bus">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="12"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Subtitle}" />
                    <ProgressBar Value="{Binding Level, Mode=OneWay}" Style="{StaticResource LevelMeter}"
                                 Height="3" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Une colonne de bus : volume, bouton couper, et ses applications -->
        <DataTemplate x:Key="BusStrip">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Width="196" Margin="0,0,10,0" Padding="10,14"
                    AllowDrop="True" DragOver="OnBusDragOver" Drop="OnBusDrop">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{Binding AccentKey, Converter={StaticResource BrushByKey}}" />
                    <TextBlock Text="{Binding VolumeText}" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,2,0,12" />

                    <Grid HorizontalAlignment="Center" Height="170">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Style="{StaticResource VerticalVolumeSlider}"
                                Value="{Binding Volume}" Height="170" />
                        <Border Grid.Column="2" Width="6" CornerRadius="3" Background="#1C1C26">
                            <Rectangle Width="6" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3"
                                       Fill="{StaticResource MeterBrush}"
                                       Height="{Binding Level, Converter={StaticResource Scale},
                                                ConverterParameter=170}" />
                        </Border>
                    </Grid>

                    <ToggleButton Style="{StaticResource SmallMuteToggle}" IsChecked="{Binding IsMuted}"
                                  HorizontalAlignment="Center" Margin="0,14,0,8"
                                  ToolTip="Couper ou réactiver ce bus" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <ToggleButton Content="S" Style="{StaticResource TinyToggle}" Margin="0,0,6,0"
                                      IsChecked="{Binding IsSolo}" ToolTip="Solo : n'entendre que ce bus" />
                        <ToggleButton Content="M" Style="{StaticResource TinyToggle}" IsChecked="{Binding IsMono}"
                                      ToolTip="Mono : ramener le son au centre" />
                    </StackPanel>

                    <TextBlock Text="APPLICATIONS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <Border Background="#101018" CornerRadius="8" MinHeight="120" Padding="8">
                        <Grid>
                            <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="11"
                                       Text="Dépose une application ici"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppChip}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Périphériques -->
        <Border Grid.Row="0" Style="{StaticResource Card}" DataContext="{Binding Mixer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ton micro" Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Microphones}"
                              SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Name" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Sortie vers Discord — choisis « CABLE Input »"
                               Style="{StaticResource FieldLabel}" />
                    <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Outputs}"
                              SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name" />
                </StackPanel>

                <Button Grid.Column="4" Content="Actualiser" Command="{Binding RefreshDevicesCommand}"
                        Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Height="36" />
            </Grid>
        </Border>

        <!-- Table de mixage -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TABLE DE MIXAGE" Style="{StaticResource SectionTitle}"
                               Margin="0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Text="Fais glisser une application d'un bus à l'autre." />
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Padding="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DataContext="{Binding Mixer}">

                        <!-- Volume général -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1" CornerRadius="12" Width="104" Margin="0,0,10,0" Padding="8,14"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Général" Foreground="{StaticResource TextBrush}" FontSize="13"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding MasterVolumeText}" Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Center" Margin="0,2,0,12" />
                                <Grid HorizontalAlignment="Center" Height="170">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource VerticalVolumeSlider}"
                                            Value="{Binding MasterVolume}" Height="170" />
                                    <Border Grid.Column="2" Width="6" CornerRadius="3" Background="#1C1C26">
                                        <Rectangle Width="6" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3"
                                                   Fill="{StaticResource MeterBrush}"
                                                   Height="{Binding MasterLevel, Converter={StaticResource Scale},
                                                            ConverterParameter=170}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="Limiteur" Foreground="{StaticResource WarningBrush}" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,16,0,0"
                                           Visibility="{Binding IsLimiting,
                                                        Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <ContentPresenter Content="{Binding Microphone}" VerticalAlignment="Top"
                                          ContentTemplate="{StaticResource ChannelStrip}" />
                        <ContentPresenter Content="{Binding Soundboard}" VerticalAlignment="Top"
                                          ContentTemplate="{StaticResource ChannelStrip}" />

                        <Border Width="1" Background="{StaticResource CardBorderBrush}" Margin="4,8,14,8" />

                        <ItemsControl ItemsSource="{Binding Buses}" ItemTemplate="{StaticResource BusStrip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Applications volontairement laissées hors du mix -->
                        <Border Width="186" Margin="4,0,0,0" Padding="10,14" CornerRadius="12"
                                BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                                Background="Transparent" VerticalAlignment="Top"
                                Visibility="{Binding HasExcludedPlaying,
                                             Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Hors du mix" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,10"
                                           TextAlignment="Center"
                                           Text="Ces applications jouent du son mais ne sont pas envoyées : tes amis s'entendraient en écho." />
                                <ItemsControl ItemsSource="{Binding ExcludedPlaying}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#16161E" CornerRadius="8" Padding="10,8"
                                                    Margin="0,0,0,6">
                                                <TextBlock Text="{Binding}" FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"
                                           TextAlignment="Center"
                                           Text="Liste modifiable dans Réglages." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Text="{Binding Mixer.SystemAudioStatus}" Style="{StaticResource MutedText}"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
