<UserControl x:Class="VoiceStudio.Views.MicrophoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel DataContext="{Binding Microphone}">

            <!-- Suppression du bruit -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Suppression du bruit" Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="Enlève le souffle du micro, le ventilateur et le bourdonnement de fond, sans couper ta voix. À utiliser à la place de Krisp, que Discord doit laisser désactivé." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding NoiseSuppressionEnabled}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Intensité" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100"
                                Value="{Binding NoiseSuppressionStrength}" />
                    </Grid>
                    <TextBlock Text="{Binding NoiseSuppressionStrengthText}" Style="{StaticResource MutedText}"
                               Margin="120,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Noise gate -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Couper le micro quand tu ne parles pas"
                                       Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="Ferme complètement le micro entre deux phrases. Si le début de tes mots saute, baisse le seuil." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding NoiseGateEnabled}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Seuil" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="-70" Maximum="-10"
                                Value="{Binding NoiseGateThresholdDb}" />
                        <TextBlock Grid.Column="2" Text="{Binding NoiseGateThresholdText}"
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Push-to-talk -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Push-to-talk" Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="Ton micro ne passe que pendant que tu maintiens la touche. Elle fonctionne même quand Voice Studio n'est pas au premier plan." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding PushToTalkEnabled}" VerticalAlignment="Top" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Choisir la touche" Command="{Binding CaptureKeyCommand}"
                                Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,10,0" />
                        <Button Content="Effacer" Command="{Binding ClearKeyCommand}"
                                Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding PushToTalkKeyText}" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Appuie maintenant sur la touche de ton choix…" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0"
                               Visibility="{Binding IsCapturingKey, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Auto-ducking -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Baisser les autres sons quand je parle"
                                       Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="La musique et les jeux reculent dès que tu prends la parole, puis remontent tout seuls." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding DuckingEnabled}" VerticalAlignment="Top" />
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Volume pendant que tu parles"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100"
                                Value="{Binding DuckingMinimumVolume}" />
                        <TextBlock Grid.Column="2" Text="{Binding DuckingMinimumVolumeText}"
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sensibilité de ta voix"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="-60" Maximum="-10"
                                Value="{Binding DuckingThresholdDb}" />
                        <TextBlock Grid.Column="2" Text="{Binding DuckingThresholdText}"
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Temps avant de remonter"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="50" Maximum="3000"
                                Value="{Binding DuckingReleaseMs}" />
                        <TextBlock Grid.Column="2" Text="{Binding DuckingReleaseText}"
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Retour audio -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="M'entendre dans mon casque" Style="{StaticResource TitleText}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,12,0"
                                       Text="Pratique pour régler les effets. Avec des enceintes, le micro risque de se réentendre : garde un casque." />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding MonitorEnabled}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Volume du retour" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="150"
                                Value="{Binding MonitorVolume}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
